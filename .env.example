# Used by docker-compose (copy to .env). Per-service settings are in docker-compose.yml.
APP_ENV=local
LOG_LEVEL=info
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars

# Shared secret that every internal gRPC call carries (x-internal-token); backends
# reject calls without it. Required to be >= 32 chars when APP_ENV=prod.
INTERNAL_TOKEN=change-me-to-another-random-string-of-32-plus-chars

# Free OCR fallback (https://ocr.space/ocrapi, 25k requests/month). Empty = RapidOCR only.
OCRSPACE_API_KEY=

# Optional Claude vision OCR provider (most accurate on crumpled/long receipts).
# Empty key = provider disabled. Empty model = the default model in the code.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional Expo access token for push notifications (Expo "enhanced push security",
# https://docs.expo.dev/push-notifications/sending-notifications/). Empty works in dev.
EXPO_ACCESS_TOKEN=

# Public URL of the web app — used to build invite links (https://<WEB_URL>/invite/<token>).
WEB_URL=http://localhost:8081

# Postgres: each service connects with its own role (deploy/postgres/init.sql);
# the local passwords there (<service>_svc_pass) are for development only.

# Other knobs (defaults in internal/platform/config):
# RATE_LIMIT_RPS=20  RATE_LIMIT_BURST=40  RATE_LIMIT_AUTH_RPS=1  RATE_LIMIT_AUTH_BURST=5
# JWT_ACCESS_TTL=15m JWT_REFRESH_TTL=720h CACHE_TTL=5m CORS_ORIGINS=*
